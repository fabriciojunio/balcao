# Contrato das variáveis de ambiente. Copie para .env e preencha.
# Nenhum segredo real entra no repositório.

# --- Banco -----------------------------------------------------------------
DATABASE_URL="postgresql://balcao:balcao@localhost:5432/balcao"

# --- Aplicação -------------------------------------------------------------
NODE_ENV="development"
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
SESSION_SECRET=""

# Loja ativa neste processo. O arquivo precisa existir em config/tenants.
TENANT_ATIVO="loja-exemplo"

# --- WhatsApp (API oficial da Meta) ----------------------------------------
# Em homologação, deixe o provedor como "simulador" na configuração da loja.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
# Token que a Meta devolve na verificação do webhook.
WHATSAPP_VERIFY_TOKEN=""
# Segredo do app, usado para conferir a assinatura de cada webhook recebido.
WHATSAPP_APP_SECRET=""

# --- Modelo ----------------------------------------------------------------
# Endereço do runtime local (Ollama, vLLM ou compatível).
MODELO_BASE_URL="http://localhost:11434"
# Contingência em nuvem. Sem chave, o sistema opera só com o modelo local.
MODELO_CONTINGENCIA_BASE_URL=""
MODELO_CONTINGENCIA_API_KEY=""

# --- Operação --------------------------------------------------------------
# Desliga o agente e devolve todas as conversas ao atendimento humano.
AGENTE_ATIVO="true"
LOG_NIVEL="info"
